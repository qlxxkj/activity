# ============ 活动广场后端 环境变量示例 ============
# 复制为 .env 后按实际填写；.env 已被 .gitignore 忽略，勿提交

# 服务端口
PORT=3000

# 微信小程序（登录 code2session 必需）
WX_APPID=wxfe3abdb95bbe4a5d
WX_SECRET=你的小程序AppSecret

# 会话签名密钥（生产必须替换，可用 openssl rand -hex 32 生成）
JWT_SECRET=dev-secret-change-me-in-prod

# 数据目录（SQLite 文件落盘位置）
# DATA_DIR=./data

# 封面图目录（默认工程根下 uploads/）
# UPLOAD_DIR=../uploads

# 封面图对外 URL 前缀（浏览器可达的完整前缀，例如 https://你的域名.com/uploads）
UPLOAD_PUBLIC_BASE=

# CORS 允许来源（逗号分隔；* 仅开发期全开）
CORS_ORIGINS=*

# 服务端管理页（/admin）登录密钥：浏览器端发布事项用
# 开发期随便填个值即可（如 dev）；生产用 openssl rand -hex 16 生成
# 未配置时 /admin 页无法登录（adminLoginRoute 返回 401）
ADMIN_TOKEN=
