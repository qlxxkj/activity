/* 统一线性图标：纯 CSS 绘制，线宽 2，圆角容器可选 */
.wb-icon {
    display: inline-block;
    position: relative;
    box-sizing: border-box;
    flex-shrink: 0;
    vertical-align: middle;
}

/* location：定位 */
.wb-icon--location {
    border: 2rpx solid currentColor;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
}
.wb-icon--location::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30%;
    height: 30%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: currentColor;
}

/* time：时钟 */
.wb-icon--time {
    border: 2rpx solid currentColor;
    border-radius: 50%;
}
.wb-icon--time::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2rpx;
    height: 32%;
    background: currentColor;
    transform: translate(-50%, 0) rotate(28deg);
    transform-origin: top center;
}

/* plus：加号 */
.wb-icon--plus::before,
.wb-icon--plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    border-radius: 2rpx;
}
.wb-icon--plus::before {
    width: 2rpx;
    height: 70%;
    transform: translate(-50%, -50%);
}
.wb-icon--plus::after {
    width: 70%;
    height: 2rpx;
    transform: translate(-50%, -50%);
}

/* signup：列表 */
.wb-icon--signup::before,
.wb-icon--signup::after {
    content: '';
    position: absolute;
    left: 15%;
    width: 70%;
    height: 2rpx;
    background: currentColor;
    border-radius: 2rpx;
}
.wb-icon--signup::before {
    top: 25%;
}
.wb-icon--signup::after {
    top: 50%;
}

/* error：感叹号 */
.wb-icon--error {
    border: 2rpx solid currentColor;
    border-radius: 50%;
}
.wb-icon--error::before,
.wb-icon--error::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: currentColor;
    border-radius: 2rpx;
}
.wb-icon--error::before {
    top: 20%;
    width: 2rpx;
    height: 36%;
}
.wb-icon--error::after {
    top: 64%;
    width: 4rpx;
    height: 4rpx;
    border-radius: 50%;
}

/* empty：空圆 */
.wb-icon--empty {
    border: 2rpx solid currentColor;
    border-radius: 50%;
}

/* info：信息 */
.wb-icon--info {
    border: 2rpx solid currentColor;
    border-radius: 50%;
}
.wb-icon--info::before,
.wb-icon--info::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: currentColor;
    border-radius: 2rpx;
}
.wb-icon--info::before {
    top: 42%;
    width: 2rpx;
    height: 34%;
}
.wb-icon--info::after {
    top: 24%;
    width: 5rpx;
    height: 5rpx;
    border-radius: 50%;
}

/* user：用户 */
.wb-icon--user::before,
.wb-icon--user::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border: 2rpx solid currentColor;
    border-radius: 50%;
}
.wb-icon--user::before {
    top: 14%;
    width: 38%;
    height: 38%;
}
.wb-icon--user::after {
    top: 58%;
    width: 80%;
    height: 44%;
    border-radius: 50% 50% 0 0;
    border-bottom: none;
}

/* camera：相机 */
.wb-icon--camera {
    border: 2rpx solid currentColor;
    border-radius: 20%;
}
.wb-icon--camera::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44%;
    height: 44%;
    transform: translate(-50%, -50%);
    border: 2rpx solid currentColor;
    border-radius: 50%;
}

/* phone：电话 */
.wb-icon--phone::before,
.wb-icon--phone::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border: 2rpx solid currentColor;
    border-radius: 50%;
}
.wb-icon--phone::before {
    top: 16%;
    width: 40%;
    height: 40%;
}
.wb-icon--phone::after {
    top: 56%;
    width: 76%;
    height: 42%;
    border-radius: 50% 50% 0 0;
    border-bottom: none;
}

/* calendar：日历 */
.wb-icon--calendar {
    border: 2rpx solid currentColor;
    border-radius: 14%;
}
.wb-icon--calendar::before {
    content: '';
    position: absolute;
    left: 0;
    top: -12%;
    width: 100%;
    height: 30%;
    background: currentColor;
    border-radius: 14% 14% 0 0;
}
.wb-icon--calendar::after {
    content: '';
    position: absolute;
    left: 22%;
    top: 42%;
    width: 2rpx;
    height: 40%;
    background: currentColor;
}

/* trash：删除 */
.wb-icon--trash {
    border: 2rpx solid currentColor;
    border-radius: 14%;
    border-top: none;
}
.wb-icon--trash::before {
    content: '';
    position: absolute;
    left: -12%;
    top: -4%;
    width: 124%;
    height: 4rpx;
    background: currentColor;
    border-radius: 2rpx;
}

/* arrow：右箭头 */
.wb-icon--arrow::before {
    content: '';
    position: absolute;
    left: 30%;
    top: 14%;
    width: 64%;
    height: 72%;
    border-top: 2rpx solid currentColor;
    border-right: 2rpx solid currentColor;
    transform: rotate(45deg);
}
