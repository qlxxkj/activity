<view class="page">
  <view class="page-head">
    <text class="page-title">我登记的事项</text>
    <text class="page-sub" wx:if="{{state === 'ready'}}">共 {{events.length}} 场</text>
  </view>

  <view class="loading" wx:if="{{state === 'loading'}}">
    <view class="spinner"></view>
  </view>

  <view class="empty" wx:elif="{{state === 'error'}}">
    <view class="empty-mark">
      <wb-icon name="error" size="56" color="#2BA84A" />
    </view>
    <text class="empty-title">加载失败</text>
    <text class="empty-desc">{{error}}</text>
    <view class="btn-ghost empty-btn" bindtap="retry">重新加载</view>
  </view>

  <view class="empty" wx:elif="{{state === 'empty'}}">
    <view class="empty-mark">
      <wb-icon name="calendar" size="56" color="#2BA84A" />
    </view>
    <text class="empty-title">还没有登记过事项</text>
    <text class="empty-desc">把要办的事记下来，方便到时提醒</text>
    <view class="btn-primary empty-btn" bindtap="goPublish">去登记事项</view>
  </view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{events}}" wx:key="id">
      <view class="item-main" bindtap="viewEvent" data-event-id="{{item.id}}">
        <view class="item-top">
          <text class="item-title">{{item.title}}</text>
          <text class="tag">已登记</text>
        </view>
        <view class="item-meta">
          <wb-icon name="calendar" size="24" color="#A79E93" />
          <text class="meta-text">{{item.timeText}}</text>
        </view>
        <view class="item-meta" wx:if="{{item.city || item.location}}">
          <wb-icon name="location" size="24" color="#A79E93" />
          <text class="meta-text">{{item.city}}{{item.location ? ' · ' + item.location : ''}}</text>
        </view>
        <view class="item-meta">
          <wb-icon name="user" size="24" color="#A79E93" />
          <text class="meta-text">{{item.capacityText}} · {{item.created_date}} 登记</text>
        </view>
      </view>

      <view class="item-foot">
        <view class="act" bindtap="viewEvent" data-event-id="{{item.id}}">查看详情</view>
      </view>
    </view>
  </view>
</view>
