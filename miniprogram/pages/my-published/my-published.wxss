.page {
    padding: 16rpx 32rpx 40rpx;
}

/* ---------- 页头 ---------- */
.page-head {
    padding: 16rpx 4rpx 32rpx;
}

.page-title {
    display: block;
    font-size: 48rpx;
    font-weight: 800;
    letter-spacing: -1rpx;
    color: #1A1815;
}

.page-sub {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #9C948B;
}

/* ---------- 列表 ---------- */
.list {
    display: flex;
    flex-direction: column;
}

.item {
    margin-bottom: 24rpx;
    background: #FFFFFF;
    border-radius: 28rpx;
    box-shadow: 0 6rpx 24rpx rgba(26, 24, 21, 0.05);
    overflow: hidden;
}

.item-main {
    padding: 30rpx 30rpx 24rpx;
}

.item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.item-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: 700;
    color: #1A1815;
    line-height: 1.4;
    margin-right: 16rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.tag {
    flex-shrink: 0;
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
    background: #E9F4EF;
    font-size: 20rpx;
    font-weight: 600;
    color: #1F7A5C;
}

.item-meta {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}

.meta-text {
    margin-left: 10rpx;
    font-size: 24rpx;
    color: #8C7F72;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.item-foot {
    display: flex;
    justify-content: flex-end;
    padding: 18rpx 30rpx;
    border-top: 2rpx solid #F4EFE8;
}

.act {
    padding: 10rpx 26rpx;
    border-radius: 999rpx;
    border: 2rpx solid #E8E1D9;
    font-size: 24rpx;
    color: #5F5A54;
}

/* ---------- 加载 ---------- */
.loading {
    display: flex;
    justify-content: center;
    padding: 160rpx 0;
}
