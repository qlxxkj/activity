.page {
    padding: 16rpx 32rpx 0;
}

/* ---------- 页头 ---------- */
.page-head {
    padding: 16rpx 4rpx 32rpx;
}

.page-title {
    display: block;
    font-size: 48rpx;
    font-weight: 800;
    letter-spacing: -1rpx;
    color: #1A1815;
}

.page-sub {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #9C948B;
    line-height: 1.6;
}

/* ---------- 分区卡片 ---------- */
.sheet {
    background: #FFFFFF;
    border-radius: 28rpx;
    padding: 30rpx 32rpx 8rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 6rpx 24rpx rgba(26, 24, 21, 0.05);
}

.sheet-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26rpx;
}

.sheet-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #1A1815;
}

.sheet-hint {
    font-size: 22rpx;
    color: #B9B1A7;
}

.field-last {
    margin-bottom: 26rpx;
}

/* ---------- 封面 ---------- */
.cover-add {
    height: 260rpx;
    margin-bottom: 30rpx;
    border: 2rpx dashed #E2D9CF;
    border-radius: 22rpx;
    background: #FAF8F5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.cover-add-text {
    margin-top: 14rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #8C7F72;
}

.cover-add-sub {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #B9B1A7;
}

.cover-edit {
    position: relative;
    margin-bottom: 30rpx;
    border-radius: 22rpx;
    overflow: hidden;
    height: 300rpx;
    background: #F3EFE9;
}

.cover-preview {
    width: 100%;
    height: 100%;
    display: block;
}

.cover-actions {
    position: absolute;
    right: 16rpx;
    bottom: 16rpx;
    display: flex;
}

.cover-btn {
    margin-left: 12rpx;
    padding: 8rpx 22rpx;
    background: rgba(26, 24, 21, 0.56);
    border-radius: 999rpx;
    font-size: 22rpx;
    color: #FFFFFF;
}

.cover-btn-danger {
    background: rgba(43, 168, 74, 0.82);
}

/* ---------- 日期 ---------- */
.date-row {
    display: flex;
}

.date-cell {
    flex: 1;
}

.date-cell:first-child {
    margin-right: 16rpx;
}

.date-box {
    padding: 18rpx 24rpx;
    background: #FAF8F5;
    border: 2rpx solid #F0EBE4;
    border-radius: 20rpx;
}

.date-label {
    display: block;
    font-size: 22rpx;
    color: #A79E93;
}

.date-value {
    display: block;
    margin-top: 6rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #1A1815;
}

/* ---------- 底部提交 ---------- */
.bottom-space {
    height: 180rpx;
}

.submit-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
    background: rgba(250, 248, 245, 0.96);
    border-top: 2rpx solid #EFE9E1;
}

.submit-btn {
    width: 100%;
}
