<view class="page">
  <view class="page-head">
    <text class="page-title">登记一个新事项</text>
    <text class="page-sub">填好基本信息，保存后即可在事项列表里查看</text>
  </view>

  <!-- 封面 -->
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">事项封面</text>
      <text class="sheet-hint">选填</text>
    </view>

    <view class="cover-edit" wx:if="{{coverPath}}">
      <image class="cover-preview" src="{{coverPath}}" mode="aspectFill" />
      <view class="cover-actions">
        <view class="cover-btn" catchtap="chooseCover">重新选择</view>
        <view class="cover-btn cover-btn-danger" catchtap="removeCover">移除</view>
      </view>
    </view>

    <view class="cover-add" wx:else bindtap="chooseCover">
      <wb-icon name="camera" size="52" color="#C0B6AA" />
      <text class="cover-add-text">添加封面图</text>
      <text class="cover-add-sub">建议横图，图片更吸引人</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">基本信息</text>
    </view>

    <view class="field">
      <text class="field-label">事项名称<text class="req">*</text></text>
      <input class="input" placeholder="例如：苏州河夜骑 · 城市灯光线" placeholder-class="input-placeholder" value="{{title}}" bindinput="onTitle" />
    </view>

    <view class="field field-last">
      <text class="field-label">事项说明</text>
      <textarea class="textarea" placeholder="写写事项内容、流程和参与安排" placeholder-class="input-placeholder" value="{{description}}" bindinput="onDesc" maxlength="500" />
    </view>
  </view>

  <!-- 时间与地点 -->
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">时间与地点</text>
    </view>

    <view class="field">
      <text class="field-label">所在城市<text class="req">*</text></text>
      <input class="input" placeholder="例如：上海" placeholder-class="input-placeholder" value="{{city}}" bindinput="onCity" />
    </view>

    <view class="field">
      <text class="field-label">具体地点</text>
      <input class="input" placeholder="例如：静安区 · 苏州河畔集合点" placeholder-class="input-placeholder" value="{{location}}" bindinput="onLocation" />
    </view>

    <view class="date-row field-last">
      <picker class="date-cell" mode="date" value="{{startTime}}" bindchange="onStartTime">
        <view class="date-box">
          <text class="date-label">开始日期</text>
          <text class="date-value">{{startTime || '请选择'}}</text>
        </view>
      </picker>
      <picker class="date-cell" mode="date" value="{{endTime}}" bindchange="onEndTime">
        <view class="date-box">
          <text class="date-label">结束日期</text>
          <text class="date-value">{{endTime || '请选择'}}</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 名额设置 -->
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">名额设置</text>
    </view>
    <view class="field field-last">
      <text class="field-label">人数上限</text>
      <input class="input" type="number" placeholder="留空表示不限人数" placeholder-class="input-placeholder" value="{{capacity}}" bindinput="onCapacity" />
    </view>
  </view>

  <text class="error-text" wx:if="{{fieldError}}">{{fieldError}}</text>
  <text class="error-text" wx:if="{{submitError}}">{{submitError}}</text>

  <view class="bottom-space"></view>
</view>

<view class="submit-bar">
  <view class="btn-primary submit-btn {{submitting ? 'is-loading' : ''}}" bindtap="submit">
    {{submitting ? '正在保存…' : '保存事项'}}
  </view>
</view>
