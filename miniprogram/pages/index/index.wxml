<view class="page">
  <!-- 定位头部：主文案城市名，副文案 区县 · 街道 -->
  <view class="loc-head">
    <view class="loc-left" bindtap="onOpenCityPicker">
      <wb-icon name="location" size="30" color="#2BA84A" />
      <view class="loc-text">
        <text class="loc-main">{{locText || '正在定位…'}}</text>
        <text class="loc-sub" wx:if="{{locDetail}}">{{locDetail}}</text>
      </view>
      <view class="city-caret"></view>
    </view>
    <view class="loc-all {{activeCity === 'ALL' ? 'loc-all-active' : ''}}" bindtap="onSelectAll">全部</view>
  </view>

  <!-- 城市选择弹层（自实现，不依赖插件） -->
  <view class="picker-mask" wx:if="{{showCityPicker}}" bindtap="closeCityPicker"></view>
  <view class="picker-sheet" wx:if="{{showCityPicker}}" catchtap="noop">
    <view class="picker-sheet-handle"></view>
    <view class="picker-sheet-title">选择城市</view>
    <view class="picker-grid">
      <view
        class="picker-grid-item {{activeCity === item ? 'picker-grid-item-active' : ''}}"
        wx:for="{{cityTabs}}"
        wx:key="*this"
        data-city="{{item}}"
        bindtap="pickCityFromSheet"
      >{{item === 'ALL' ? '全部' : item}}</view>
    </view>
  </view>

  <!-- 城市横向筛选 -->
  <scroll-view class="city-tabs" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      class="city-tab {{activeCity === item ? 'city-tab-active' : ''}}"
      wx:for="{{cityTabs}}"
      wx:key="*this"
      data-city="{{item}}"
      bindtap="selectCity"
    >
      <text class="city-tab-text">{{item === 'ALL' ? '全部' : item}}</text>
    </view>
  </scroll-view>

  <!-- 加载 -->
  <view class="loading" wx:if="{{state === 'loading'}}">
    <view class="spinner"></view>
  </view>

  <!-- 错误 -->
  <view class="empty" wx:elif="{{state === 'error'}}">
    <view class="empty-mark">
      <wb-icon name="error" size="56" color="#2BA84A" />
    </view>
    <text class="empty-title">没能加载出来</text>
    <text class="empty-desc">{{error}}</text>
    <view class="btn-ghost empty-btn" bindtap="retry">重新加载</view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:elif="{{state === 'empty'}}">
    <view class="empty-mark">
      <wb-icon name="calendar" size="56" color="#2BA84A" />
    </view>
    <text class="empty-title">这里还没有事项</text>
    <text class="empty-desc">记下{{activeCity === 'ALL' ? '你' : activeCity}}要预约或登记的事项</text>
    <view class="btn-ghost empty-btn" bindtap="goMySignups">查看我的事项</view>
  </view>

  <!-- 事项列表 -->
  <block wx:else>
    <view class="list-head">
      <text class="list-eyebrow">RECORDS</text>
      <text class="list-count">{{events.length}} 条记录</text>
    </view>

    <view class="event-list">
      <view class="event-card" wx:for="{{events}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="cover">
          <image class="cover-img" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
          <view class="cover-fallback" wx:else>
            <text class="cover-initial">{{item.initial}}</text>
          </view>
          <view class="date-badge">
            <text class="db-month">{{item.monthText}}</text>
            <text class="db-day">{{item.dayText}}</text>
          </view>
          <view class="cover-city" wx:if="{{item.city}}">{{item.city}}</view>
        </view>

        <view class="card-main">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta">
            <view class="meta-item">
              <wb-icon name="time" size="26" color="#9C948B" />
              <text class="meta-text">{{item.timeText}}</text>
            </view>
            <view class="meta-item" wx:if="{{item.location}}">
              <wb-icon name="location" size="26" color="#9C948B" />
              <text class="meta-text">{{item.location}}</text>
            </view>
          </view>
          <view class="card-foot">
            <view class="host">
              <view class="host-avatar">{{item.hostInitial}}</view>
              <text class="host-name">{{item.owner_name || '我'}}</text>
            </view>
            <text class="cap">{{item.capacityText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
