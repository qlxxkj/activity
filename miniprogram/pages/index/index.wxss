.page {
    padding: 24rpx 32rpx 56rpx;
}

/* ---------- 城市选择（系统导航栏下方，左对齐胶囊） ---------- */
.city-picker {
    display: inline-block;
    margin-bottom: 8rpx;
}

.city-chip {
    display: inline-flex;
    align-items: center;
    gap: 8rpx;
    height: 64rpx;
    padding: 0 20rpx 0 14rpx;
    background: #FFFFFF;
    border-radius: 999rpx;
    box-shadow: 0 4rpx 14rpx rgba(26, 24, 21, 0.06);
}

.city-chip-text {
    max-width: 132rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 24rpx;
    font-weight: 600;
    color: #1A1815;
}

.city-caret {
    width: 0;
    height: 0;
    margin-left: 2rpx;
    border-left: 6rpx solid transparent;
    border-right: 6rpx solid transparent;
    border-top: 7rpx solid #9C948B;
}

/* ---------- 城市筛选 ---------- */
.city-tabs {
    white-space: nowrap;
    padding: 12rpx 0 20rpx;
}

.city-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 64rpx;
    padding: 0 30rpx;
    margin-right: 16rpx;
    background: #FFFFFF;
    border-radius: 999rpx;
    box-shadow: 0 4rpx 14rpx rgba(26, 24, 21, 0.04);
}

.city-tab-text {
    font-size: 26rpx;
    font-weight: 500;
    color: #6E6862;
}

.city-tab-active {
    background: #1A1815;
    box-shadow: 0 6rpx 16rpx rgba(26, 24, 21, 0.18);
}

.city-tab-active .city-tab-text {
    color: #FFFFFF;
    font-weight: 600;
}

/* ---------- 列表头 ---------- */
.list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 8rpx 0 20rpx;
}

.list-eyebrow {
    font-size: 22rpx;
    font-weight: 700;
    letter-spacing: 4rpx;
    color: #C0B6AA;
}

.list-count {
    font-size: 24rpx;
    color: #9C948B;
}

/* ---------- 活动卡片 ---------- */
.event-list {
    display: flex;
    flex-direction: column;
}

.event-card {
    margin-bottom: 28rpx;
    background: #FFFFFF;
    border-radius: 28rpx;
    overflow: hidden;
    box-shadow: 0 6rpx 24rpx rgba(26, 24, 21, 0.05);
}

.cover {
    position: relative;
    width: 100%;
    height: 300rpx;
    background: #F3EFE9;
}

.cover-img {
    width: 100%;
    height: 100%;
    display: block;
}

.cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #E7F6EC 0%, #D3F0DE 48%, #C2E9D2 100%);
}

.cover-initial {
    font-size: 120rpx;
    font-weight: 800;
    color: rgba(43, 168, 74, 0.24);
    letter-spacing: 4rpx;
    transform: translateY(-6rpx);
}

.date-badge {
    position: absolute;
    left: 24rpx;
    top: 24rpx;
    width: 96rpx;
    padding: 10rpx 0 12rpx;
    background: rgba(255, 255, 255, 0.94);
    border-radius: 18rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 6rpx 16rpx rgba(26, 24, 21, 0.1);
}

.db-month {
    font-size: 20rpx;
    font-weight: 600;
    color: #2BA84A;
    line-height: 1.2;
}

.db-day {
    font-size: 34rpx;
    font-weight: 800;
    color: #1A1815;
    line-height: 1.1;
    margin-top: 2rpx;
}

.cover-city {
    position: absolute;
    right: 20rpx;
    top: 24rpx;
    padding: 6rpx 16rpx;
    background: rgba(26, 24, 21, 0.42);
    border-radius: 999rpx;
    font-size: 20rpx;
    color: #FFFFFF;
    letter-spacing: 1rpx;
}

.card-main {
    padding: 26rpx 28rpx 24rpx;
}

.card-title {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: #1A1815;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.card-meta {
    margin-top: 16rpx;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
    margin-bottom: 8rpx;
}

.meta-text {
    flex: 1;
    font-size: 25rpx;
    color: #6E6862;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid #F4EFE8;
}

.host {
    display: flex;
    align-items: center;
    gap: 12rpx;
    min-width: 0;
}

.host-avatar {
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: #E3F6E9;
    color: #2BA84A;
    font-size: 22rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.host-name {
    font-size: 24rpx;
    color: #9C948B;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cap {
    flex-shrink: 0;
    font-size: 22rpx;
    font-weight: 600;
    color: #2BA84A;
}

/* ---------- 加载 ---------- */
.loading {
    display: flex;
    justify-content: center;
    padding: 160rpx 0;
}
