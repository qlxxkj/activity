/* ---------- 封面 ---------- */
.hero {
    position: relative;
    width: 100%;
    height: 460rpx;
    background: #F3EFE9;
    overflow: hidden;
}

.hero-img {
    width: 100%;
    height: 100%;
    display: block;
}

.hero-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, #E7F6EC 0%, #F5D5C7 55%, #EEC4B4 100%);
}

.hero-initial {
    font-size: 220rpx;
    font-weight: 800;
    color: rgba(43, 168, 74, 0.2);
    transform: translateY(-20rpx);
}

.hero-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220rpx;
    background: linear-gradient(180deg, rgba(26, 24, 21, 0) 0%, rgba(26, 24, 21, 0.34) 100%);
}

.hero-date {
    position: absolute;
    left: 32rpx;
    bottom: 84rpx;
    display: flex;
    align-items: center;
}

.hd-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 96rpx;
    padding: 10rpx 14rpx 12rpx;
    background: rgba(255, 255, 255, 0.96);
    border-radius: 18rpx;
}

.hd-month {
    font-size: 20rpx;
    font-weight: 700;
    color: #2BA84A;
    letter-spacing: 1rpx;
}

.hd-day {
    font-size: 40rpx;
    font-weight: 800;
    color: #1A1815;
    line-height: 1.05;
}

.hd-right {
    margin-left: 18rpx;
    display: flex;
    flex-direction: column;
}

.hd-week {
    font-size: 28rpx;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 1rpx;
}

.hd-city {
    margin-top: 4rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.82);
}

/* ---------- 内容 ---------- */
.body {
    position: relative;
    margin-top: -56rpx;
    padding: 0 32rpx;
}

.sheet {
    background: #FFFFFF;
    border-radius: 28rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 6rpx 24rpx rgba(26, 24, 21, 0.05);
}

.sheet-top {
    padding-top: 36rpx;
}

.detail-title {
    display: block;
    font-size: 42rpx;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.5rpx;
    color: #1A1815;
}

.rows {
    margin-top: 28rpx;
}

.row {
    display: flex;
    align-items: flex-start;
    padding: 18rpx 0;
    border-top: 2rpx solid #F4EFE8;
}

.row:first-child {
    border-top: none;
    padding-top: 4rpx;
}

.row-ico {
    width: 64rpx;
    height: 64rpx;
    border-radius: 20rpx;
    background: #E3F6E9;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.row-text {
    flex: 1;
    margin-left: 20rpx;
    min-width: 0;
    padding-top: 2rpx;
}

.row-label {
    display: block;
    font-size: 22rpx;
    color: #A79E93;
    letter-spacing: 1rpx;
}

.row-value {
    display: block;
    margin-top: 6rpx;
    font-size: 28rpx;
    font-weight: 500;
    color: #1A1815;
    line-height: 1.5;
}

.block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.block-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    color: #1A1815;
}

.block-count {
    font-size: 24rpx;
    color: #9C948B;
}

.desc {
    display: block;
    margin-top: 18rpx;
    font-size: 28rpx;
    line-height: 1.8;
    color: #5F5A54;
}

/* ---------- 报名记录 ---------- */
.signup-empty {
    padding: 28rpx 0;
    text-align: center;
    border-top: 2rpx solid #F4EFE8;
}

.se-text {
    font-size: 26rpx;
    color: #A79E93;
}

.signup-row {
    display: flex;
    align-items: center;
    padding: 22rpx 0;
    border-top: 2rpx solid #F4EFE8;
}

.s-avatar {
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    background: #F3EFE9;
    color: #8C7F72;
    font-size: 28rpx;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.s-info {
    flex: 1;
    margin-left: 20rpx;
    min-width: 0;
}

.s-name {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #1A1815;
}

.s-phone {
    display: block;
    margin-top: 4rpx;
    font-size: 24rpx;
    color: #9C948B;
    letter-spacing: 0.5rpx;
}

.s-time {
    flex-shrink: 0;
    font-size: 22rpx;
    color: #B9B1A7;
}

/* ---------- 底部栏 ---------- */
.bottom-space {
    height: 160rpx;
}

.bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
    background: rgba(250, 248, 245, 0.96);
    border-top: 2rpx solid #EFE9E1;
}

.bb-left {
    display: flex;
    align-items: baseline;
    flex-shrink: 0;
    margin-right: 24rpx;
}

.bb-num {
    font-size: 40rpx;
    font-weight: 800;
    color: #1A1815;
}

.bb-label {
    margin-left: 6rpx;
    font-size: 22rpx;
    color: #9C948B;
}

.bb-btn {
    flex: 1;
}

.bb-danger {
    color: #B2331F;
    border-color: #EED9D2;
}

/* ---------- 加载 ---------- */
.loading {
    display: flex;
    justify-content: center;
    padding: 200rpx 0;
}
