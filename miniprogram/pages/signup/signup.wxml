<view class="page">
  <!-- 正在报名的活动 -->
  <view class="event-strip" wx:if="{{event}}">
    <view class="strip-date">
      <text class="sd-month">{{event.monthText}}</text>
      <text class="sd-day">{{event.dayText}}</text>
    </view>
    <view class="strip-info">
      <text class="strip-title">{{event.title}}</text>
      <text class="strip-meta">{{event.timeText}}{{event.city ? ' · ' + event.city : ''}}</text>
    </view>
  </view>

  <view class="page-head">
    <text class="page-title">填写报名信息</text>
    <text class="page-sub">主办方会通过手机号与你确认</text>
  </view>

  <view class="sheet">
    <view class="field">
      <text class="field-label">姓名<text class="req">*</text></text>
      <input class="input" placeholder="请输入真实姓名" placeholder-class="input-placeholder" value="{{userName}}" bindinput="onNameInput" />
    </view>

    <view class="field">
      <text class="field-label">手机号<text class="req">*</text></text>
      <input class="input" type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="input-placeholder" value="{{userPhone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field field-last">
      <text class="field-label">备注</text>
      <textarea class="textarea textarea-sm" placeholder="选填，比如同行人数、饮食禁忌" placeholder-class="input-placeholder" value="{{userNote}}" bindinput="onNoteInput" maxlength="100" />
    </view>
  </view>

  <text class="error-text" wx:if="{{fieldError}}">{{fieldError}}</text>
  <text class="error-text" wx:if="{{submitError}}">{{submitError}}</text>

  <text class="tip">报名信息仅对本次活动主办方可见</text>

  <view class="bottom-space"></view>
</view>

<view class="submit-bar">
  <view class="btn-primary submit-btn {{submitting ? 'is-loading' : ''}}" bindtap="submit">
    {{submitting ? '正在提交…' : '提交报名'}}
  </view>
</view>
