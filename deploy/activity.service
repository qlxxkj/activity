[Unit]
Description=activity miniprogram backend (Node + Express + SQLite)
After=network.target

[Service]
Type=simple
User=hawk
WorkingDirectory=/home/hawk/activity/backend
EnvironmentFile=/home/hawk/activity/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
